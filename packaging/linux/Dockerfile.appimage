FROM ubuntu:22.04@sha256:2edbbc5dc405e9612ba3584ce95480277e3eb374407b5505fe26f17df77c7dbc

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        appstream \
        ca-certificates \
        curl \
        desktop-file-utils \
        file \
        ffmpeg \
        g++ \
        libdbus-1-3 \
        libegl1 \
        libfontconfig1 \
        libfuse2 \
        libgl1 \
        libgl-dev \
        libglx-dev \
        libopengl0 \
        libopengl-dev \
        libpulse0 \
        libx11-xcb1 \
        libxrandr2 \
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-render-util0 \
        libxcb-xinerama0 \
        libxcb-xkb1 \
        libxkbcommon-x11-0 \
        ninja-build \
        patchelf \
        pulseaudio \
        python3-pip \
        zsync \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir \
        aqtinstall==3.3.0 \
        cmake==3.31.6 \
    && aqt install-qt linux desktop 6.9.3 linux_gcc_64 \
        -O /opt/Qt \
        --modules qtmultimedia qtwaylandcompositor

RUN curl -fsSL \
        https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
        -o /usr/local/bin/linuxdeploy-x86_64.AppImage \
    && echo "421ca71d5c69ea97c6309276232990d43df1dcece0edfaa26bbf926ff96ed12e  /usr/local/bin/linuxdeploy-x86_64.AppImage" | sha256sum --check --strict \
    && curl -fsSL \
        https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-x86_64.AppImage \
        -o /usr/local/bin/linuxdeploy-plugin-qt-x86_64.AppImage \
    && echo "be1b7e166bf9975cfb694ebe6759ba40502ffc6196440d3e64aa90c4dbd67e9f  /usr/local/bin/linuxdeploy-plugin-qt-x86_64.AppImage" | sha256sum --check --strict \
    && chmod 0755 \
        /usr/local/bin/linuxdeploy-x86_64.AppImage \
        /usr/local/bin/linuxdeploy-plugin-qt-x86_64.AppImage

ENV QT_ROOT=/opt/Qt/6.9.3/gcc_64
ENV PATH=/opt/Qt/6.9.3/gcc_64/bin:${PATH}
ENV CMAKE_PREFIX_PATH=/opt/Qt/6.9.3/gcc_64
ENV APPIMAGE_EXTRACT_AND_RUN=1
